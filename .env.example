# Copy to .env.local for `npm run dev`, and to .dev.vars for `npm run preview`.
# On Cloudflare, set the secrets with `npx wrangler secret put <NAME>`.

# Supabase → Project settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API keys (use rzp_test_… keys until launch)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → https://<domain>/api/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Resend → API keys. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Headstart Frontier Tech Week <tickets@headstart.co.in>"
EMAIL_REPLY_TO=hello@headstart.co.in
